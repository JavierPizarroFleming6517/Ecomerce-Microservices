{
  "name": "@retail/eslint-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "base.mjs",
    "nest.mjs",
    "react.mjs"
  ],
  "exports": {
    ".": "./base.mjs",
    "./base": "./base.mjs",
    "./nest": "./nest.mjs",
    "./react": "./react.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node -e \"Promise.all(['./base.mjs','./nest.mjs','./react.mjs'].map((file)=>import(file)))\"",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@eslint/js": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.20.0"
  },
  "peerDependencies": {
    "eslint": ">=9.18.0"
  },
  "devDependencies": {
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "eslint": "^9.18.0",
    "typescript": "^5.8.3"
  }
}
