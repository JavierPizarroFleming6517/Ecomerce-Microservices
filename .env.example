NODE_ENV=development
WEB_PORT=5173
API_GATEWAY_PORT=3000
USERS_SERVICE_PORT=3001
CATALOG_SERVICE_PORT=3002
RECOMMENDATIONS_SERVICE_PORT=3003

VITE_API_BASE_URL=http://localhost:3000/api/v1
CORS_ORIGINS=http://localhost:5173

RABBITMQ_URL=amqp://retail:retail-local@localhost:5672
RABBITMQ_USER=retail
RABBITMQ_PASSWORD=retail-local

POSTGRES_DB=retail_users
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail-local
DATABASE_URL=postgresql://retail:retail-local@localhost:5432/retail_users?schema=public
DIRECT_URL=postgresql://retail:retail-local@localhost:5432/retail_users?schema=public

MONGO_INITDB_ROOT_USERNAME=retail
MONGO_INITDB_ROOT_PASSWORD=retail-local
MONGODB_URI=mongodb://retail:retail-local@localhost:27017/retail_catalog?authSource=admin
MONGODB_DB_NAME=retail_catalog

NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=retail-local-password
NEO4J_DATABASE=neo4j

JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
